# Modelo dos segredos locais do proxy da IA.
# Não coloque a chave aqui. Rode .\configurar-local.ps1 (ou copie este arquivo para .dev.vars e preencha).
# O arquivo .dev.vars fica só na sua máquina: ele está no .gitignore.

GEMINI_API_KEY=cole_a_chave_do_google_ai_studio_aqui

# Opcional: outro modelo do Gemini, se o padrão do worker.js não existir na sua conta.
# GEMINI_MODELO=

# Reserva (Groq): usada quando o Gemini falha ou estoura o limite.
# Chave em https://console.groq.com > API Keys. Modelo: copie o nome exato em Models.
RESERVA_URL=https://api.groq.com/openai/v1/chat/completions
RESERVA_API_KEY=cole_a_chave_do_groq_aqui
RESERVA_MODELO=nome_do_modelo_do_groq
